{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/foundation_execution_manifest.schema.json",
  "title": "Gate 6D2 foundation execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate",
    "subgate",
    "status",
    "execution_commit",
    "contract_version",
    "candidate_ids",
    "candidate_count",
    "successful_candidate_count",
    "outer_fold_count",
    "validation_origins_per_candidate",
    "prediction_row_count",
    "maximum_prediction_origin",
    "maximum_target_dependency",
    "common_context_length_intervals",
    "forecast_horizon_intervals",
    "zero_shot_only",
    "quantile_outputs_authoritative",
    "locked_test_accessed",
    "locked_predictions_parsed",
    "confirmatory_evaluation_performed",
    "fine_tuning_performed",
    "calibration_performed",
    "hyperparameter_search_performed",
    "automatic_promotion_permitted",
    "human_decision_required",
    "v1_immutable",
    "external_api_cost_usd",
    "total_wall_clock_seconds",
    "output_hashes",
    "environment_hashes",
    "next_gate"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "gate": {"const": "6D"},
    "subgate": {"const": "6D2"},
    "status": {"const": "validation_complete_pending_human_decision"},
    "execution_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_version": {"const": "1.0.0"},
    "candidate_ids": {
      "const": [
        "chronos_2_zero_shot",
        "timesfm_2_5_zero_shot",
        "moirai_2_research_zero_shot"
      ]
    },
    "candidate_count": {"const": 3},
    "successful_candidate_count": {"const": 3},
    "outer_fold_count": {"const": 4},
    "validation_origins_per_candidate": {"const": 7004},
    "prediction_row_count": {"const": 21012},
    "maximum_prediction_origin": {"maximum": 28027},
    "maximum_target_dependency": {"maximum": 28028},
    "common_context_length_intervals": {"const": 672},
    "forecast_horizon_intervals": {"const": 1},
    "zero_shot_only": {"const": true},
    "quantile_outputs_authoritative": {"const": false},
    "locked_test_accessed": {"const": false},
    "locked_predictions_parsed": {"const": false},
    "confirmatory_evaluation_performed": {"const": false},
    "fine_tuning_performed": {"const": false},
    "calibration_performed": {"const": false},
    "hyperparameter_search_performed": {"const": false},
    "automatic_promotion_permitted": {"const": false},
    "human_decision_required": {"const": true},
    "v1_immutable": {"const": true},
    "external_api_cost_usd": {"const": 0.0},
    "total_wall_clock_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 21600},
    "output_hashes": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "environment_hashes": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "next_gate": {"const": "6D3"}
  }
}
