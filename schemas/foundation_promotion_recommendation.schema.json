{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/foundation_promotion_recommendation.schema.json",
  "title": "Gate 6D2 foundation promotion recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate",
    "subgate",
    "status",
    "automatic_promotion_permitted",
    "human_decision_required",
    "eligible_candidates",
    "candidates",
    "recommended_next_gate"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "gate": {"const": "6D"},
    "subgate": {"const": "6D2"},
    "status": {"const": "validation_complete_pending_human_decision"},
    "automatic_promotion_permitted": {"const": false},
    "human_decision_required": {"const": true},
    "eligible_candidates": {
      "type": "array",
      "items": {
        "enum": ["chronos_2_zero_shot", "timesfm_2_5_zero_shot"]
      },
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "benchmark_status",
          "commercial_use_eligible",
          "promotion_eligible",
          "failed_requirements"
        ],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "benchmark_status": {"const": "success"},
          "commercial_use_eligible": {"type": "boolean"},
          "promotion_eligible": {"type": "boolean"},
          "failed_requirements": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "recommended_next_gate": {"const": "6D3"}
  }
}
