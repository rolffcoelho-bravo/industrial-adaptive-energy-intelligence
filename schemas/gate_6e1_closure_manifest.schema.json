{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/gate_6e1_closure_manifest.schema.json",
  "title": "Gate 6E1 uncertainty contract closure manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate", "subgate", "status", "contract_path",
    "retained_point_model", "candidate_method_ids", "configuration_count",
    "target_coverage_levels", "primary_coverage_level", "controls",
    "parent_identities", "required_gate_6e2_outputs", "next_gate",
    "next_gate_authorized", "blocked_gates"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "gate": {"const": "6E"},
    "subgate": {"const": "6E1"},
    "status": {"const": "closed"},
    "contract_path": {"const": "configs/uncertainty_contract.yml"},
    "retained_point_model": {"const": "v1_frozen_champion"},
    "candidate_method_ids": {
      "const": [
        "expanding_absolute_conformal",
        "rolling_absolute_conformal",
        "adaptive_absolute_conformal"
      ]
    },
    "configuration_count": {"const": 9},
    "target_coverage_levels": {"const": [0.8, 0.9, 0.95]},
    "primary_coverage_level": {"const": 0.9},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_only", "point_model_search_performed",
        "point_model_fit_performed", "calibration_performed",
        "intervals_generated", "uncertainty_metrics_calculated",
        "optimization_executed", "locked_test_accessed",
        "locked_predictions_parsed", "confirmatory_evaluation_performed",
        "automatic_promotion_permitted", "probabilistic_authority_claimed",
        "v1_immutable", "gate_6d_closed", "human_decision_required"
      ],
      "properties": {
        "implementation_only": {"const": true},
        "point_model_search_performed": {"const": false},
        "point_model_fit_performed": {"const": false},
        "calibration_performed": {"const": false},
        "intervals_generated": {"const": false},
        "uncertainty_metrics_calculated": {"const": false},
        "optimization_executed": {"const": false},
        "locked_test_accessed": {"const": false},
        "locked_predictions_parsed": {"const": false},
        "confirmatory_evaluation_performed": {"const": false},
        "automatic_promotion_permitted": {"const": false},
        "probabilistic_authority_claimed": {"const": false},
        "v1_immutable": {"const": true},
        "gate_6d_closed": {"const": true},
        "human_decision_required": {"const": true}
      }
    },
    "parent_identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_6d_closure_path", "gate_6d_closure_git_blob_sha",
        "selected_model_manifest_path", "selected_model_manifest_git_blob_sha",
        "hist_gradient_boosting_candidate_manifest_path",
        "hist_gradient_boosting_candidate_manifest_git_blob_sha",
        "model_contract_path", "model_contract_git_blob_sha",
        "optimization_governance_path", "optimization_governance_git_blob_sha",
        "gate_6e_issue", "base_commit"
      ],
      "properties": {
        "gate_6d_closure_path": {"const": "outputs/v2/gate_6d/gate_6d_closure_manifest.json"},
        "gate_6d_closure_git_blob_sha": {"pattern": "^[0-9a-f]{40}$"},
        "selected_model_manifest_path": {"const": "outputs/modeling/selected_model_manifest.json"},
        "selected_model_manifest_git_blob_sha": {"pattern": "^[0-9a-f]{40}$"},
        "hist_gradient_boosting_candidate_manifest_path": {"const": "outputs/modeling/hist_gradient_boosting_candidate_manifest.json"},
        "hist_gradient_boosting_candidate_manifest_git_blob_sha": {"pattern": "^[0-9a-f]{40}$"},
        "model_contract_path": {"const": "configs/model_contract.yml"},
        "model_contract_git_blob_sha": {"pattern": "^[0-9a-f]{40}$"},
        "optimization_governance_path": {"const": "configs/optimization_governance.yml"},
        "optimization_governance_git_blob_sha": {"pattern": "^[0-9a-f]{40}$"},
        "gate_6e_issue": {"const": 24},
        "base_commit": {"const": "212524867ea50020e5788159ff366dce14731b73"}
      }
    },
    "required_gate_6e2_outputs": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "uniqueItems": true, "items": {"type": "string", "minLength": 3}
    },
    "next_gate": {"const": "6E2"},
    "next_gate_authorized": {"const": false},
    "blocked_gates": {"const": ["6E2", "6E3", "6F", "6G"]}
  }
}
