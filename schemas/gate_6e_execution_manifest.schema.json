{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shockbridgepulse.com/schemas/gate_6e_execution_manifest.schema.json",
  "title": "Gate 6E2 governed uncertainty execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate",
    "subgate",
    "status",
    "execution_commit",
    "contract_version",
    "retained_point_model",
    "configuration_ids",
    "configuration_count",
    "coverage_levels",
    "outer_fold_count",
    "validation_origins_per_configuration",
    "interval_prediction_row_count",
    "calibration_residual_row_count",
    "maximum_prediction_origin",
    "maximum_target_dependency",
    "locked_test_start",
    "point_prediction_parity_violation_count",
    "calibration_performed",
    "intervals_generated",
    "uncertainty_metrics_calculated",
    "optimization_executed",
    "point_model_search_performed",
    "point_model_mutated",
    "locked_test_accessed",
    "locked_predictions_parsed",
    "confirmatory_evaluation_performed",
    "automatic_promotion_permitted",
    "probabilistic_authority_claimed",
    "human_decision_required",
    "v1_immutable",
    "canonical_device",
    "external_api_cost_usd",
    "total_wall_clock_seconds",
    "peak_memory_mb",
    "artifact_size_bytes",
    "output_hashes",
    "recommendation_outcome",
    "recommended_configuration",
    "next_gate",
    "next_gate_authorized",
    "blocked_gates"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "gate": {"const": "6E"},
    "subgate": {"const": "6E2"},
    "status": {"const": "validation_complete_pending_human_decision"},
    "execution_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_version": {"const": "1.0.0"},
    "retained_point_model": {"const": "v1_frozen_champion"},
    "configuration_ids": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "configuration_count": {"const": 9},
    "coverage_levels": {
      "const": [0.8, 0.9, 0.95]
    },
    "outer_fold_count": {"const": 4},
    "validation_origins_per_configuration": {"const": 7004},
    "interval_prediction_row_count": {"const": 63036},
    "calibration_residual_row_count": {"type": "integer", "minimum": 2688},
    "maximum_prediction_origin": {"const": 28027},
    "maximum_target_dependency": {"const": 28028},
    "locked_test_start": {"const": 28032},
    "point_prediction_parity_violation_count": {"const": 0},
    "calibration_performed": {"const": true},
    "intervals_generated": {"const": true},
    "uncertainty_metrics_calculated": {"const": true},
    "optimization_executed": {"const": true},
    "point_model_search_performed": {"const": false},
    "point_model_mutated": {"const": false},
    "locked_test_accessed": {"const": false},
    "locked_predictions_parsed": {"const": false},
    "confirmatory_evaluation_performed": {"const": false},
    "automatic_promotion_permitted": {"const": false},
    "probabilistic_authority_claimed": {"const": false},
    "human_decision_required": {"const": true},
    "v1_immutable": {"const": true},
    "canonical_device": {"const": "cpu"},
    "external_api_cost_usd": {"const": 0.0},
    "total_wall_clock_seconds": {"type": "number", "minimum": 0},
    "peak_memory_mb": {"type": "number", "minimum": 0, "maximum": 4096},
    "artifact_size_bytes": {"type": "integer", "minimum": 1, "maximum": 262144000},
    "output_hashes": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "recommendation_outcome": {
      "enum": ["no_action", "recommend_reference", "recommend_challenger"]
    },
    "recommended_configuration": {
      "type": ["string", "null"]
    },
    "next_gate": {"const": "6E3"},
    "next_gate_authorized": {"const": false},
    "blocked_gates": {"const": ["6E3", "6F", "6G"]}
  }
}
