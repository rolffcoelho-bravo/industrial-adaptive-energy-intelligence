{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/governed_search_space.schema.json",
  "title": "Governed Search Space",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "gate",
    "search_space_id",
    "candidate_family",
    "algorithm_id",
    "data_boundary",
    "parameter_space",
    "budget",
    "seeds",
    "objectives",
    "hard_constraints",
    "provenance"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "gate": {"enum": ["6B", "6C", "6D", "6E", "6F", "6G"]},
    "search_space_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "candidate_family": {
      "enum": [
        "advanced_tabular",
        "neural_forecasting",
        "foundation_model",
        "uncertainty_calibrator",
        "ensemble"
      ]
    },
    "algorithm_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admissible_partitions",
        "locked_test_access_permitted",
        "fold_strategy",
        "outer_fold_count",
        "inner_fold_count",
        "purge_intervals"
      ],
      "properties": {
        "admissible_partitions": {"const": ["training", "validation"]},
        "locked_test_access_permitted": {"const": false},
        "fold_strategy": {"const": "nested_expanding_window"},
        "outer_fold_count": {"const": 4},
        "inner_fold_count": {"const": 3},
        "purge_intervals": {"const": 4}
      }
    },
    "parameter_space": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/parameter"}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_unique_trials",
        "max_parallel_trials",
        "max_retries_per_trial",
        "max_wall_clock_minutes"
      ],
      "properties": {
        "max_unique_trials": {"type": "integer", "minimum": 1, "maximum": 500},
        "max_parallel_trials": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_retries_per_trial": {"type": "integer", "minimum": 0, "maximum": 1},
        "max_wall_clock_minutes": {"type": "integer", "minimum": 1, "maximum": 720}
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hard_constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optimization_contract_version",
        "code_commit",
        "created_by_role",
        "human_approved",
        "approved_before_execution"
      ],
      "properties": {
        "optimization_contract_version": {"const": "1.0.0"},
        "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "created_by_role": {"enum": ["human", "deterministic_system", "genai_advisory"]},
        "human_approved": {"const": true},
        "approved_before_execution": {"const": true}
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
        "type": {"enum": ["integer", "number", "categorical", "boolean"]},
        "required": {"type": "boolean"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "log_scale": {"type": "boolean"},
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": ["string", "number", "integer", "boolean"]
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["integer", "number"]}}},
          "then": {"required": ["minimum", "maximum"]}
        },
        {
          "if": {"properties": {"type": {"const": "categorical"}}},
          "then": {"required": ["values"]}
        },
        {
          "if": {"properties": {"type": {"const": "boolean"}}},
          "then": {"not": {"anyOf": [{"required": ["minimum"]}, {"required": ["maximum"]}, {"required": ["values"]}]}}
        }
      ]
    }
  }
}
