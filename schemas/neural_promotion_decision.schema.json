{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/neural_promotion_decision.schema.json",
  "title": "Gate 6C neural promotion decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate",
    "candidate_id",
    "decision",
    "human_authority",
    "automatic_promotion_permitted",
    "locked_test_accessed",
    "confirmatory_evaluation_performed",
    "rationale",
    "next_action"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "gate": {"const": "6C"},
    "candidate_id": {
      "enum": ["nhits_compact", "tide_compact", "patchtst_compact"]
    },
    "decision": {"enum": ["promote", "reject", "defer"]},
    "human_authority": {"const": true},
    "automatic_promotion_permitted": {"const": false},
    "locked_test_accessed": {"const": false},
    "confirmatory_evaluation_performed": {"const": false},
    "rationale": {"type": "string", "minLength": 20},
    "next_action": {
      "enum": ["freeze_candidate", "retain_incumbent", "request_additional_validation"]
    }
  }
}
