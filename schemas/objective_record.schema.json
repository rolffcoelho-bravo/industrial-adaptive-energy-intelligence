{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/objective_record.schema.json",
  "title": "Optimization Objective Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "objective_set_version",
    "trial_id",
    "fold_id",
    "seed",
    "partition",
    "metrics",
    "computed_by",
    "source_artifact_sha256",
    "status"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "objective_set_version": {"const": "v2_objectives_1.0.0"},
    "trial_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "fold_id": {"type": "integer", "minimum": 1, "maximum": 4},
    "seed": {"type": "integer", "minimum": 1},
    "partition": {"const": "validation"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "computed_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "code_commit", "deterministic"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "deterministic": {"const": true}
      }
    },
    "source_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["complete", "failed"]},
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["error_type", "message"],
      "properties": {
        "error_type": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {"required": ["failure"]}
    }
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "unit", "direction", "finite"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "direction": {"enum": ["minimize", "maximize"]},
        "finite": {"const": true}
      }
    }
  }
}
