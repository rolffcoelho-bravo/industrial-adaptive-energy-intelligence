{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/trial_evidence.schema.json",
  "title": "Optimization Trial Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "trial_id",
    "search_space_id",
    "search_space_sha256",
    "candidate_family",
    "algorithm_id",
    "parameter_values",
    "fold_ids",
    "seeds",
    "objective_records",
    "hard_constraint_results",
    "resource_usage",
    "environment",
    "code_commit",
    "outcome",
    "artifact_sha256"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "trial_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "search_space_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "search_space_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_family": {
      "enum": [
        "advanced_tabular",
        "neural_forecasting",
        "foundation_model",
        "uncertainty_calibrator",
        "ensemble"
      ]
    },
    "algorithm_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "parameter_values": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "fold_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 4}
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "objective_records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/objectiveRecord"}
    },
    "hard_constraint_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/constraintResult"}
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_seconds", "peak_memory_mb", "model_size_bytes", "p95_inference_latency_ms_per_1000_rows"],
      "properties": {
        "wall_clock_seconds": {"type": "number", "minimum": 0},
        "peak_memory_mb": {"type": "number", "minimum": 0},
        "model_size_bytes": {"type": "integer", "minimum": 0},
        "p95_inference_latency_ms_per_1000_rows": {"type": "number", "minimum": 0}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "platform", "dependency_lock_sha256", "execution_adapter"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_adapter": {"enum": ["portable", "databricks", "gcp"]}
      }
    },
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "outcome": {"enum": ["success", "failed", "pruned", "budget_exhausted"]},
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["stage", "error_type", "message", "retry_count"],
      "properties": {
        "stage": {"type": "string", "minLength": 1},
        "error_type": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retry_count": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "failed"}}},
      "then": {"required": ["failure"]}
    }
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "unit", "direction", "finite"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "direction": {"enum": ["minimize", "maximize"]},
        "finite": {"const": true}
      }
    },
    "objectiveRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "objective_set_version",
        "trial_id",
        "fold_id",
        "seed",
        "partition",
        "metrics",
        "computed_by",
        "source_artifact_sha256",
        "status"
      ],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "objective_set_version": {"const": "v2_objectives_1.0.0"},
        "trial_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "fold_id": {"type": "integer", "minimum": 1, "maximum": 4},
        "seed": {"type": "integer", "minimum": 1},
        "partition": {"const": "validation"},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/metric"}
        },
        "computed_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "code_commit", "deterministic"],
          "properties": {
            "implementation": {"type": "string", "minLength": 1},
            "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "deterministic": {"const": true}
          }
        },
        "source_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["complete", "failed"]},
        "failure": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["error_type", "message"],
          "properties": {
            "error_type": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "constraintResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observed_value", "operator", "threshold", "passed"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "observed_value": {"type": "number"},
        "operator": {"enum": ["equal", "less_than_or_equal", "greater_than_or_equal"]},
        "threshold": {"type": "number"},
        "passed": {"type": "boolean"}
      }
    }
  }
}
